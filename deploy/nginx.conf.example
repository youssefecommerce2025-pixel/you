# Configuration Nginx : reverse proxy vers l'app Node (port 3000) + HTTPS.
# Copier vers : /etc/nginx/sites-available/leads-mutuelle
# Activer     : sudo ln -s /etc/nginx/sites-available/leads-mutuelle /etc/nginx/sites-enabled/
# Tester      : sudo nginx -t  &&  sudo systemctl reload nginx
#
# Remplace "ton-domaine.fr" par ton vrai domaine.
# Le HTTPS (blocs 443 / certificats) est ajoute AUTOMATIQUEMENT par certbot (voir guide).

server {
    listen 80;
    listen [::]:80;
    server_name ton-domaine.fr www.ton-domaine.fr;

    # Taille max des requetes (formulaires legers).
    client_max_body_size 1m;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
}
