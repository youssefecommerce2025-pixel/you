# Service systemd pour lancer l'application au demarrage et la relancer si elle plante.
# Copier vers : /etc/systemd/system/leads-fibre.service
# Puis :
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now leads-fibre
#   sudo systemctl status leads-fibre

[Unit]
Description=Plateforme leads fibre Proximus (Node.js)
After=network.target

[Service]
Type=simple
# Adapte l'utilisateur et le chemin a ton installation.
User=deploy
WorkingDirectory=/var/www/leads-fibre
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3

# Variables d'environnement chargees depuis un fichier (voir .env.example).
EnvironmentFile=/var/www/leads-fibre/.env

# Securite de base
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
