# Copie ce fichier en ".env" et remplis tes vraies valeurs.
#   cp .env.example .env
# En production (systemd), place ce fichier a la racine de l'app (voir deploy/).

# --- Obligatoire ---
PORT=3000
# Token d'acces au CRM (mets une valeur longue et secrete).
ADMIN_TOKEN=change-moi-avec-une-valeur-longue-et-secrete

# URL publique de ton site (pour les liens de confirmation double opt-in).
PUBLIC_BASE_URL=https://ton-domaine.fr

# --- WhatsApp (funnel + bouton click-to-WhatsApp) ---
# Format international sans + ni espaces, ex Martinique : 596696XXXXXX
WHATSAPP_NUMBER=

# --- Double opt-in (recommande) ---
DOUBLE_OPTIN=0

# --- Email (SMTP) pour le double opt-in ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@ton-domaine.fr

# --- SMS (fournisseur HTTP : Twilio, OVH, Vonage...) ---
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=Mutuelle

# --- Webhook de transmission vers le CRM d'un courtier partenaire ---
PARTNER_WEBHOOK_URL=
PARTNER_WEBHOOK_SECRET=
# Webhook specifique par courtier (optionnel) : PARTNER_WEBHOOK_URL__NOM_ORIAS=...

# --- Intake de leads d'affilies externes (cle:Nom,cle2:Nom2) ---
PARTNER_API_KEYS=

# --- CORS (seulement si tu heberges le frontend sur un autre domaine) ---
# ALLOWED_ORIGINS=https://ton-frontend.fr

# --- Prefill social (optionnel) ---
# Google Cloud Console → Identifiants OAuth (type Web) → Client ID
# Active aussi "Google People API" pour date de naissance + adresse/CP.
GOOGLE_CLIENT_ID=
# Meta for Developers → ID de l'application Facebook
# Permissions utilisées : public_profile + email (sans App Review).
FACEBOOK_APP_ID=
# Apple Developer → Identifiers → Services ID (Sign in with Apple)
# Return URL / Domain : https://assurdom.fr  et  https://assurdom.fr/
# Apple fournit nom + e-mail (pas date de naissance ni code postal).
APPLE_CLIENT_ID=

# --- Pixels publicitaires Meta + TikTok (optionnel) ---
# Les pixels navigateur ne se chargent QU'APRES consentement cookies "publicite".
# IDs publics (visibles dans le HTML / /api/config) :
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
# Conversions API serveur (recommandé : mesure même si le navigateur bloque le pixel).
# Meta Events Manager → Réglages → API Conversions → Jeton d'accès
META_CAPI_TOKEN=
# TikTok Events Manager → Paramètres → Access Token (Events API)
TIKTOK_ACCESS_TOKEN=
# Optionnel : codes de test (Events Manager → Test events), à retirer en production
# META_TEST_EVENT_CODE=
# TIKTOK_TEST_EVENT_CODE=

# --- Emplacement de la base SQLite ---
DATA_DIR=/var/www/leads-mutuelle/data
