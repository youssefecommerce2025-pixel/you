# Copie ce fichier en ".env" et remplis tes vraies valeurs.
#   cp .env.example .env
# En production (systemd), place ce fichier a la racine de l'app (voir deploy/).

# --- Obligatoire ---
PORT=3000
# Token d'acces au CRM (mets une valeur longue et secrete).
ADMIN_TOKEN=change-moi-avec-une-valeur-longue-et-secrete

# URL publique de ton site (pour les liens de confirmation double opt-in).
PUBLIC_BASE_URL=https://ton-domaine.be

# --- Identite de la societe (mentions legales + certificat de consentement) ---
ORG_BRAND=ProxiFibre
ORG_LEGAL_NAME=Ta Societe SRL (partenaire agree Proximus)
ORG_LEGAL_FORM=SRL
# Numero d'entreprise BCE / KBO (10 chiffres)
ORG_BCE=BE 0XXX.XXX.XXX
ORG_ADDRESS=Rue Exemple 1, 1000 Bruxelles
ORG_EMAIL=contact@proxifibre.be
ORG_DPO_EMAIL=privacy@proxifibre.be
ORG_PHONE=+32 2 000 00 00
# Produit / reseau commercialise
ORG_OPERATOR=Proximus
# Reference de licence DNCM (« Ne m'appelez plus ! ») de la societe qui te mandate
ORG_DNCM_LICENSE=

# --- WhatsApp (funnel + bouton click-to-WhatsApp) ---
# Format international sans + ni espaces, ex Belgique : 32470000000
WHATSAPP_NUMBER=

# --- Double opt-in (recommande pour anticiper l'opt-in belge) ---
DOUBLE_OPTIN=0

# --- Email (SMTP) pour le double opt-in ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@ton-domaine.be

# --- SMS (fournisseur HTTP : Twilio, OVH, Vonage...) ---
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=ProxiFibre

# --- Webhook de transmission vers le CRM de la societe partenaire ---
PARTNER_WEBHOOK_URL=
PARTNER_WEBHOOK_SECRET=
# Webhook specifique par partenaire (optionnel) : PARTNER_WEBHOOK_URL__NOM=...

# --- Intake de leads d'affilies externes (cle:Nom,cle2:Nom2) ---
PARTNER_API_KEYS=

# --- Emplacement de la base SQLite ---
DATA_DIR=/var/www/leads-fibre/data
